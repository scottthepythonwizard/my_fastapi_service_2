# Only Archive needs the database URL and write token.
SOLE_DATABASE_URL=postgresql://sole_catalog_api.PROJECT_REF:PASSWORD@POOLER_HOST:6543/postgres
SOLE_ADMIN_TOKEN=GENERATE_A_RANDOM_ADMIN_TOKEN

# Optional. Archive includes the Supabase public root certificate by default.
# SOLE_DATABASE_CA_FILE=C:/path/to/prod-ca-2021.crt

# This catalog read key is visible in browser configuration.
# SOLE_API_KEY=student-api-key-123
SOLE_ARCHIVE_ORIGIN=http://127.0.0.1:8000
SOLE_FIT_ORIGIN=http://127.0.0.1:8002
# For separate hosted sites, set Archive CORS to the Compare origin.
# SOLE_CORS_ORIGINS=https://compare.example
# SOLE_FIT_CORS_ORIGINS=https://archive.example
